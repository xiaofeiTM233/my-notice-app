import { Theme } from "theme.slint";

// 右下角滑入的通知弹窗。窗口本身透明且比卡片大一圈，留给阴影，
// 卡片在窗口内做位移/淡入动画，避免逐帧移动窗口带来的开销与撕裂。
export component ToastWindow inherits Window {
    in property <string> head;
    in property <string> body;
    in property <string> src;
    in property <string> mark;
    in property <string> tag;
    in property <int> cat;
    in property <int> prio;
    in property <bool> act;
    in property <bool> shown: false;
    in property <bool> counting: false;
    in property <length> cw: 360px;
    in property <length> ch: 104px;
    in property <duration> anim: 240ms;
    in property <duration> dwell: 6s;
    in property <length> pad: 18px;

    callback opened();
    callback closed();
    callback hovered(bool);

    title: "NotifyHub";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Microsoft YaHei UI";
    width: root.cw + 2 * root.pad;
    height: root.ch + 2 * root.pad;

    card := Rectangle {
        y: root.pad;
        width: root.cw;
        height: root.ch;
        x: root.shown ? root.pad : root.width;
        opacity: root.shown ? 1.0 : 0.0;
        animate x { duration: root.anim; easing: cubic-bezier(0.16, 1, 0.3, 1); }
        animate opacity { duration: root.anim; }

        background: Theme.bg;
        border-radius: Theme.rl;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shade;
        clip: true;

        ta := TouchArea {
            mouse-cursor: root.act ? MouseCursor.pointer : MouseCursor.default;
            clicked => { root.opened(); }
            changed has-hover => { root.hovered(self.has-hover); }
        }

        // 优先级色条
        Rectangle {
            x: 0; y: 0;
            width: 4px;
            height: parent.height;
            background: Theme.prios[root.prio];
        }

        // 分类图标
        Rectangle {
            x: 14px;
            y: (root.ch - 38px) / 2;
            width: 38px;
            height: 38px;
            border-radius: Theme.rm;
            background: Theme.cats[root.cat].with-alpha(0.16);
            Text {
                text: root.mark;
                color: Theme.cats[root.cat];
                font-size: 15px;
                font-weight: 700;
            }
        }

        // 来源行
        Text {
            x: 64px; y: 15px;
            width: root.cw - 64px - 42px;
            text: root.tag + " · " + root.src;
            font-size: 11px;
            color: Theme.fg3;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        // 标题
        Text {
            x: 64px; y: 35px;
            width: root.cw - 64px - 20px;
            height: 20px;
            text: root.head;
            font-size: 14px;
            font-weight: 700;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        // 正文（两行）
        Text {
            x: 64px; y: 57px;
            width: root.cw - 64px - 20px;
            height: 32px;
            text: root.body;
            font-size: 12px;
            color: Theme.fg2;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: left;
        }

        // 关闭按钮，悬停时显现
        Rectangle {
            x: root.cw - 32px; y: 10px;
            width: 22px; height: 22px;
            border-radius: 11px;
            background: cta.has-hover ? Theme.hover : transparent;
            opacity: ta.has-hover || cta.has-hover ? 1.0 : 0.0;
            animate opacity { duration: 120ms; }
            Text {
                text: "×";
                font-size: 16px;
                color: Theme.fg2;
            }
            cta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.closed(); }
            }
        }

        // 自动消失倒计时条；悬停时隐藏（此时上层会取消自动关闭）
        Rectangle {
            x: 0;
            y: root.ch - 3px;
            height: 3px;
            width: root.counting ? 0px : root.cw;
            background: Theme.cats[root.cat];
            opacity: ta.has-hover ? 0.0 : 0.8;
            animate width { duration: root.dwell; easing: linear; }
            animate opacity { duration: 120ms; }
        }
    }
}
