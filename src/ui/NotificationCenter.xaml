<UserControl
    x:Class="WinNotify.NotificationCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="CardBg" Color="#252525"/>
        <SolidColorBrush x:Key="CardBorder" Color="#333333"/>
        <SolidColorBrush x:Key="CardHoverBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="TitleColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ContentColor" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="MutedColor" Color="#666666"/>
        <SolidColorBrush x:Key="AccentColor" Color="#409EFF"/>
        <SolidColorBrush x:Key="UnreadDot" Color="#409EFF"/>

        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="FilterBtnActive" TargetType="Button" BasedOn="{StaticResource FilterBtn}">
            <Setter Property="Background" Value="#33409EFF"/>
            <Setter Property="Foreground" Value="#409EFF"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Padding="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="通知中心"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleColor}"/>
                <Border x:Name="UnreadBadge"
                        Background="#33409EFF"
                        CornerRadius="10"
                        MinWidth="20"
                        Height="20"
                        Padding="6,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="UnreadCountText"
                               Text="0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#409EFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="全部已读"
                        Click="MarkAllRead_Click"
                        Style="{StaticResource FilterBtn}"
                        Height="28"/>
                <Button Content="清空"
                        Click="ClearAll_Click"
                        Style="{StaticResource FilterBtn}"
                        Height="28"/>
            </StackPanel>
        </Grid>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Padding="20,0,20,12">
            <muxc::AutoSuggestBox x:Name="SearchBox"
                                  PlaceholderText="搜索通知..."
                                  QuerySubmitted="SearchBox_QuerySubmitted"
                                  TextChanged="SearchBox_TextChanged"
                                  Height="36"
                                  CornerRadius="8"/>
        </Grid>

        <!-- 分类筛选 -->
        <ScrollViewer Grid.Row="1"
                      Padding="20,0,20,12"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,40,0,0">
            <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAll" Content="全部" Click="Filter_Click" Tag="all" Style="{StaticResource FilterBtnActive}"/>
                <Button x:Name="BtnUnread" Content="未读" Click="Filter_Click" Tag="unread" Style="{StaticResource FilterBtn}"/>
                <Button x:Name="BtnMessage" Content="消息" Click="Filter_Click" Tag="message" Style="{StaticResource FilterBtn}"/>
                <Button x:Name="BtnReminder" Content="提醒" Click="Filter_Click" Tag="reminder" Style="{StaticResource FilterBtn}"/>
                <Button x:Name="BtnSystem" Content="系统" Click="Filter_Click" Tag="system" Style="{StaticResource FilterBtn}"/>
                <Button x:Name="BtnAlert" Content="告警" Click="Filter_Click" Tag="alert" Style="{StaticResource FilterBtn}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 通知列表 -->
        <ScrollViewer Grid.Row="2"
                      x:Name="ListScroll"
                      Padding="20,0,20,0">
            <ItemsControl x:Name="NotifyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,10"
                                Tapped="NotifyItem_Tapped"
                                Tag="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 未读圆点 -->
                                <Ellipse x:Name="UnreadIndicator"
                                         Grid.Column="0"
                                         Width="8"
                                         Height="8"
                                         Fill="{StaticResource UnreadDot}"
                                         Margin="0,4,10,0"
                                         Visibility="{Binding UnreadVis}"/>

                                <!-- 标题 -->
                                <TextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TitleColor}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>

                                <!-- 删除按钮 -->
                                <Button Grid.Column="2"
                                        Grid.Row="0"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="DeleteBtn_Click"
                                        Tag="{Binding Id}"
                                        Margin="4,-4,-4,0"
                                        VerticalAlignment="Top">
                                    <FontIcon FontFamily="Segoe MDL2 Assets"
                                              Glyph="&#xE711;"
                                              FontSize="11"
                                              Foreground="#555555"/>
                                </Button>

                                <!-- 内容 -->
                                <TextBlock Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding Content}"
                                           FontSize="12"
                                           Foreground="{StaticResource ContentColor}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>

                                <!-- 底部信息 -->
                                <StackPanel Grid.Column="1"
                                            Grid.Row="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,8,0,0">
                                    <Border Background="#222222"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedColor}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Time}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态 -->
        <Grid Grid.Row="2" x:Name="EmptyState" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon FontFamily="Segoe MDL2 Assets"
                          Glyph="&#xE91C;"
                          FontSize="48"
                          Foreground="#333333"/>
                <TextBlock Text="暂无通知"
                           FontSize="14"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="3" Padding="20,12" Background="#151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnStatus" Text="已连接" FontSize="11" Foreground="#888888"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="TotalCount"
                       Text="共 0 条"
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
