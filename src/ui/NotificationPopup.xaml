<UserControl
    x:Class="WinNotify.NotificationPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PopupBg" Color="#CC202020" Opacity="0.92"/>
        <SolidColorBrush x:Key="PopupBorder" Color="#33FFFFFF" Opacity="0.15"/>
        <SolidColorBrush x:Key="TitleColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ContentColor" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TimeColor" Color="#888888"/>
        <SolidColorBrush x:Key="CloseBtnHover" Color="#33FFFFFF"/>

        <!-- 优先级颜色 -->
        <SolidColorBrush x:Key="PriUrgent" Color="#FF4444"/>
        <SolidColorBrush x:Key="PriHigh" Color="#FF9800"/>
        <SolidColorBrush x:Key="PriNormal" Color="#2196F3"/>
        <SolidColorBrush x:Key="PriLow" Color="#9E9E9E"/>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource PopupBg}"
            BorderBrush="{StaticResource PopupBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Width="360"
            Padding="16,14"
            HorizontalAlignment="Stretch">
        <Border.Shadow>
            <muxc:ThemeShadow/>
        </Border.Shadow>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 优先级指示条 -->
            <Border x:Name="PriorityBar"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    Width="4"
                    CornerRadius="2"
                    Margin="0,0,12,0"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource PriNormal}"/>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Grid.Row="0"
                       Text="{x:Bind Title}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleColor}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <!-- 关闭按钮 -->
            <Button x:Name="CloseBtn"
                    Grid.Column="2"
                    Grid.Row="0"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseBtn_Click"
                    Margin="8,-4,-4,0"
                    VerticalAlignment="Top">
                <FontIcon FontFamily="Segoe MDL2 Assets"
                          Glyph="&#xE711;"
                          FontSize="12"
                          Foreground="#888888"/>
            </Button>

            <!-- 内容 -->
            <TextBlock x:Name="ContentText"
                       Grid.Column="1"
                       Grid.Row="1"
                       Text="{x:Bind Content}"
                       FontSize="13"
                       Foreground="{StaticResource ContentColor}"
                       TextWrapping="Wrap"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0"/>

            <!-- 时间和分类 -->
            <StackPanel Grid.Column="1"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,8,0,0"
                        Spacing="8">
                <TextBlock x:Name="CategoryText"
                           FontSize="11"
                           Foreground="{StaticResource TimeColor}"
                           Text="{x:Bind Category}"/>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource TimeColor}"
                           Text="·"/>
                <TextBlock x:Name="TimeText"
                           FontSize="11"
                           Foreground="{StaticResource TimeColor}"
                           Text="{x:Bind TimeStr}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
