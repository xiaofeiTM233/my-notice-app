<Window
    x:Class="NotificationManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Notification Manager"
    Width="420" Height="640"
    MinWidth="360" MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    SystemBackdrop="Mica">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Title Bar -->
        <Grid Grid.Row="0" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Notification Center"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Ellipse x:Name="ConnDot" Width="8" Height="8"
                         Fill="#CCCCCC" Margin="0,0,4,0"/>
                <TextBlock x:Name="ConnStatus" Text="Disconnected"
                           FontSize="11" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnSettings" Style="{StaticResource DefaultButtonStyle}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                        Width="32" Height="32" Click="OnSettings"/>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="16,8,16,4">
            <controls:TextBox x:Name="SearchBox" PlaceholderText="Search notifications..."
                              TextChanged="OnSearchChanged">
                <controls:TextBox.Resources>
                    <Style TargetType="controls:TextBox">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </controls:TextBox.Resources>
            </controls:TextBox>
        </Grid>

        <!-- Category Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,4,16,8" Spacing="6">
            <Button x:Name="TabAll" Content="All" Width="56" Height="28"
                    FontSize="12" CornerRadius="14"
                    Click="OnFilterAll"/>
            <Button x:Name="TabMsg" Content="Messages" Width="72" Height="28"
                    FontSize="12" CornerRadius="14"
                    Click="OnFilterMsg"/>
            <Button x:Name="TabRem" Content="Reminders" Width="76" Height="28"
                    FontSize="12" CornerRadius="14"
                    Click="OnFilterRem"/>
            <Button x:Name="TabSys" Content="System" Width="64" Height="28"
                    FontSize="12" CornerRadius="14"
                    Click="OnFilterSys"/>
        </StackPanel>

        <!-- Notification List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Padding="16,0,16,8">
            <StackPanel x:Name="NotifList" Spacing="0">
                <TextBlock x:Name="EmptyLabel" Text="No notifications"
                           Foreground="{StaticResource TextTertiary}"
                           FontSize="14" HorizontalAlignment="Center"
                           Margin="0,40,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Grid Grid.Row="4" Height="44" Padding="16,0"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="UnreadBadge"
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <HyperlinkButton Grid.Column="1" Content="Clear All"
                             FontSize="12" Click="OnClearAll"/>
        </Grid>

        <!-- Toast Popup Overlay -->
        <Popup x:Name="ToastOverlay" Grid.RowSpan="5"
               IsOpen="False" IsLightDismissEnabled="False"
               HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel x:Name="ToastPanel" Spacing="8"
                        Margin="0,0,16,60" MaxWidth="360"/>
        </Popup>
    </Grid>
</Window>
