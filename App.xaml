<Application
    x:Class="NotificationManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#999999"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="UnreadDot" Color="#0078D4"/>
            <SolidColorBrush x:Key="CatMessage" Color="#0078D4"/>
            <SolidColorBrush x:Key="CatReminder" Color="#FF8C00"/>
            <SolidColorBrush x:Key="CatSystem" Color="#E81123"/>
            <SolidColorBrush x:Key="CatCustom" Color="#886CE4"/>
            <SolidColorBrush x:Key="PriUrgent" Color="#E81123"/>
            <SolidColorBrush x:Key="PriHigh" Color="#FF8C00"/>

            <!-- Styles -->
            <Style x:Key="DateHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>

            <Style x:Key="NotifCardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="NotifTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="NotifBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxLines" Value="2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
